# Clé service_role Supabase (jamais l'anon key) — nécessaire pour lire toutes les interactions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Origines autorisées en CORS (le domaine du frontend web + l'app mobile en dev), séparées par des virgules.
ALLOWED_ORIGINS=*
